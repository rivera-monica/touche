# Copy this file to .env.local and fill in the values from your Supabase
# project's Settings → API page.

# Safe to expose to the browser — used by the client-side Supabase SDK.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER expose this to the browser or commit it. Only used by scripts/seed.mjs,
# run from your own machine, to bypass RLS for the initial data load.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
